---
import Layout from '../layouts/Layout.astro'
import { RadioGroup, Textarea, Select, Option} from '../components/FormControl';

---

<Layout>
    <div class="form-control-display">
        <h3 class="font-bold">Role</h3>
        <div class="subhead text-body3">Lists show all choices at once in one place.</div>
        <br/>
        <Select name="select-example" label="select-example" id="select-example-id">
            <Option label="UX & Research" value="ux&research" />
            <Option label="Healthcare & Nursing" value="healthcare&nursing"/>
            <Option label="Product & Stategy" value="product&strateg"/>
        </Select>
    </div>
    <br/>
    <div class="form-control-display">
        <h3 class="font-bold">Comfort level</h3>
        <div class="subhead text-body3">Radio groups denote one clear choice.</div>
        <br/>
        <RadioGroup name="radio-group" options={[
            {value: 'beginner', label: 'Beginner'},
            {value: 'learning', label: 'Learning'},
            {value: 'intermediate', label: 'Intermediate'},
            {value: 'advanced', label: 'Advanced'},
        ]}/>
    </div>
    <br/>
    <div class="form-control-display">
        <h3 class="font-bold">Reflection</h3>
        <div class="subhead text-body3">Longer input feels supportive.</div>
        <br/>
        <Textarea name="textarea-example" label="" rows={4} cols={4} placeholder="What could you try in your work this week?"/>
    </div>
</Layout>
